# Cloudflare Pages headers. The page itself is never cached by default, but assets are
# cached for four hours, so after a deploy visitors ran the old script.js against the new
# page (and the new API) until their cache expired. Re-check these on every load instead.
/script.js
  Cache-Control: public, max-age=0, must-revalidate
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
